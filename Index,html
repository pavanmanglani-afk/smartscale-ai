            }))),
        h('div', { className: 'foot-bottom' }, '© ' + new Date().getFullYear() + ' Smart Scale AI. All rights reserved.')));
  }

  function App() {
    useEffect(function () {
      var id = (window.location.hash || '').replace('#', '');
      if (SECTION_IDS.indexOf(id) === -1) return;
      var el = document.getElementById(id);
      if (el) setTimeout(function () { el.scrollIntoView({ behavior: 'auto', block: 'start' }); }, 80);
    }, []);
    return h(React.Fragment, null,
      h(Header),
      h('main', null, h(Hero), h(Services), h(About), h(How), h(Receptionist), h(Contact)),
      h(Footer));
  }

  ReactDOM.createRoot(document.getElementById('root')).render(h(App));
})();

</script>
</body>
</html>
